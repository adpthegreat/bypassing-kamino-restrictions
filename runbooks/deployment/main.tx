################################################################
# Manage bypassing-kamino-restrictions deployment through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_kamino_juplend_refinance" "svm::deploy_program" {
    description = "Deploy kamino_juplend_refinance program"
    program = svm::get_program_from_native_project("kamino_juplend_refinance") 
    authority = signer.authority
    payer = signer.payer
    // Write the program data directly to the program account via a Surfnet
    // cheatcode: instantaneous, and avoids the multi-tx BPF upload (which hammers
    // the forked RPC). Only affects Surfnet targets; devnet/mainnet still deploy
    // the normal way.
    instant_surfnet_deployment = true
}
